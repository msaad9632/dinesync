# Copy to .env and adjust as needed. Loaded via `node --env-file=.env server.js`.

# Origin allowed to call the API (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Port the API listens on
PORT=5000

# production suppresses Express's default stack-trace error pages
NODE_ENV=production

# SQL Server ODBC connection string. Default (see backend/db.js) targets a
# local SQLEXPRESS instance with Windows Authentication.
DB_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=localhost\SQLEXPRESS;Database=DineSyncDB;Trusted_Connection=yes;
